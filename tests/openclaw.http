@OPENCLAW_GATEWAY_TOKEN = {{$dotenv OPENCLAW_GATEWAY_TOKEN}}

# Protocol : http | ws
@protocol = http

# Host : localhost | 0.0.0.0
@host = localhost

# Port : 18789
@port = 18789

@baseUrl = {{protocol}}://{{host}}:{{port}}

@Authorization = Bearer {{OPENCLAW_GATEWAY_TOKEN}}

# TESTS ENDPOINTS GATEWAY

## TESTS CONTROL UI


### Test 1 : Web Interface
GET {{baseUrl}}/
Authorization : {{Authorization}}


### Test 2 : Configuration
GET {{baseUrl}}/control-ui-config.json
Authorization : {{Authorization}}


### Test 3 : Model List/Agents
GET {{baseUrl}}/v1/models
Authorization : {{Authorization}}


### Test 4 : Model Informations
GET {{baseUrl}}/v1/models/main
Authorization : {{Authorization}}


### Test 5 : API compatible LLM Chat
POST {{baseUrl}}/v1/chat/completions
Authorization : {{Authorization}}
Content-Type: application/json

{}


### Test 6 : API LLM Responses
POST {{baseUrl}}/v1/responses
Authorization : {{Authorization}}
Content-Type: application/json

{}


### Test 7 : Embeddings Generation
POST {{baseUrl}}/v1/embeddings
Authorization : {{Authorization}}
Content-Type: application/json

{}


### Test 8 : Tools invoke
POST {{baseUrl}}/tools/invoke
Authorization : {{Authorization}}
Content-Type: application/json

{}


### Test 9 : Gateway Administration (plugin admin-http-rpc)
POST {{baseUrl}}/api/v1/admin/rpc
Authorization : {{Authorization}}
Content-Type: application/json

{
  "method":"health",
  "params":{}
}

